{
  "name": "aeolus-fleet-selfhost-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:compose && npm run check:pins && npm run check:syntax && npm run check:no-em-dash",
    "check:compose": "node scripts/check-compose.js",
    "check:pins": "node scripts/check-pins.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:no-em-dash": "node scripts/check-no-em-dash.js",
    "test": "node --test --test-concurrency=1 test/stack.test.js",
    "test:base": "node --test --test-name-pattern='^base stack$' test/stack.test.js",
    "test:profiles": "node --test --test-name-pattern='^all profiles$' test/stack.test.js"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
