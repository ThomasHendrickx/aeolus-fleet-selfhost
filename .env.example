# Exact released versions. All images read their pins here.
CORE_VERSION=0.43.0
CONSOLE_VERSION=0.43.0
SQUADRONS_VERSION=0.39.0
TRIERARCH_PLUGIN_VERSION=0.42.1
GATEWAY_VERSION=0.42.0
NODE_VERSION=26.0.0
POSTGRES_VERSION=16.6

# Public addresses must be reachable by browsers, ships AND the plugins.
PUBLIC_URL=http://localhost:4000
CONSOLE_ORIGIN=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:4300
# Set these only for profiles you enable.
AEOLUS_SQUADRONS_URL=
AEOLUS_TRIERARCH_PLUGIN_URL=
AEOLUS_GATEWAY_URL=

# Direct/session connections to separate databases, including for external Postgres.
# With the postgres profile, use host postgres and port 5432, for example:
# postgresql://aeolus:<encoded password>@postgres:5432/aeolus
# Plugin owners and databases: aeolus_squadrons, aeolus_trierarch_plugin, aeolus_gateway.
# Optional console addresses: http://squadrons:4100,
# http://trierarch-plugin:4200 and http://gateway:4300, respectively.
DATABASE_URL=
SQUADRONS_DATABASE_URL=
TRIERARCH_PLUGIN_DATABASE_URL=
GATEWAY_DATABASE_URL=

# For the optional postgres profile. URL-encode passwords in connection URLs.
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
SQUADRONS_DB_PASSWORD=
TRIERARCH_PLUGIN_DB_PASSWORD=
GATEWAY_DB_PASSWORD=
# Required only for the gateway profile: at least 32 characters; keep permanently.
GATEWAY_SECRET=
